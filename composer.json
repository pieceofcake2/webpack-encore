{
    "name": "pieceofcake2/webpack-encore",
    "description": "View helper that loads Symfony Webpack Encore-built assets in CakePHP 2",
    "type": "cakephp-plugin",
    "keywords": ["cakephp", "cakephp2", "webpack", "webpack-encore"],
    "license": "MIT",
    "require": {
        "php": "^8.0",
        "composer/installers": "^1.0 || ^2.0",
        "pieceofcake2/cakephp": "^2.12"
    },
    "require-dev": {
        "cakephp/cakephp-codesniffer": "^5.0",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^9.6",
        "pieceofcake2/app": "^2.2",
        "pieceofcake2/phpstan-cakephp2": "^0.2.3"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "composer/installers": true,
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "extra": {
        "installer-name": "WebpackEncore"
    }
}
